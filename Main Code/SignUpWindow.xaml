<Window x:Class="Contract_MC_System.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up" Height="450" Width="400" WindowStartupLocation="CenterScreen">

    <Grid Background="#34495e">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Sign Up" FontSize="24" Foreground="White" FontWeight="Bold" Margin="0 0 0 20" HorizontalAlignment="Center"/>

            <TextBlock Text="Username" Foreground="White"/>
            <TextBox Name="UsernameTextBox" Width="250" Height="30" Margin="0 5"/>

            <TextBlock Text="Password" Foreground="White"/>
            <PasswordBox Name="PasswordBox" Width="250" Height="30" Margin="0 5"/>

            <TextBlock Text="Confirm Password" Foreground="White" Margin="0 10 0 0"/>
            <PasswordBox Name="ConfirmPasswordBox" Width="250" Height="30" Margin="0 5"/>

            <TextBlock Text="Select Role" Foreground="White" Margin="0 10 0 0"/>
            <ComboBox Name="RoleComboBox" Width="250" Height="30" Margin="0 5">
                <ComboBoxItem Content="Lecturer" IsSelected="True"/>
                <ComboBoxItem Content="Coordinator"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>

            <Button Content="Sign Up" Width="250" Height="35" Background="#2980b9" Foreground="White" Margin="10 20 10 0" Click="SignUp_Click"/>
            <Button Content="Back to Login" Width="150" Height="25" Click="BackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
